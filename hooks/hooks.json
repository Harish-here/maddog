{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/executor-guard.sh\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/judge-dispatch-guard.sh\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Edit|Write|Bash|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pattern-declare-guard.sh\""
          }
        ]
      }
    ]
  }
}
