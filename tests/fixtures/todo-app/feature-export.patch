@@ -0,0 +1,11 @@
+import csv
+import sys
+
+from todo import store
+
+
+def export_csv(out=sys.stdout) -> None:
+    writer = csv.writer(out)
+    writer.writerow(["id", "title", "due", "done"])
+    for item in store.load():
+        writer.writerow([item["id"], item["title"], item["due"], item["done"]])
